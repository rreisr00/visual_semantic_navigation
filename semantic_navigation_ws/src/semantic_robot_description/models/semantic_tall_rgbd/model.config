<?xml version="1.0"?>
<model>
  <name>Semantic tall RGB-D robot</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Visual Semantic Navigation project</name>
  </author>

  <description>
    TurtleBot3 Waffle differential-drive base with a physical sensor tower and
    a registered Gazebo RGB-D camera. Camera height and pitch are substituted
    by semantic_bringup when the model is spawned.
  </description>
</model>
