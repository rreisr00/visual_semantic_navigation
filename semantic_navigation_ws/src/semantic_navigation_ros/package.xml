<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_navigation_ros</name>
  <version>0.1.0</version>
  <description>
    Thin ROS 2 coordinators for visual-semantic navigation. Hosts the teaching
    action server (kg_manager / CaptureWaypoint), the runtime retrieval+navigate
    action server (semantic_orchestrator / NavigateToSemanticGoal) and a
    lifecycle manager that supervises the vision and knowledge-graph nodes.
    All ranking and capture sequencing lives in the pure semantic_navigation_core.
  </description>
  <maintainer email="rreisr00@estudiantes.unileon.es">developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>semantic_interfaces</exec_depend>
  <exec_depend>semantic_navigation_core</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
