<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_evaluation</name>
  <version>0.1.0</version>
  <description>
    UF-7 evaluation tooling for the semantic navigation stack: real-time metric
    collection + CSV export, graphical and keyboard teleoperation with waypoint
    capture, room creation, and an RViz2 knowledge-graph visualizer. Business
    logic lives in a pure-Python core (semantic_evaluation.core).
  </description>
  <maintainer email="rreisr00@estudiantes.unileon.es">developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>semantic_interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <!-- Offline experiment core (retrieval methods, graph store, dataset adapter). -->
  <exec_depend>semantic_navigation_core</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
