<?xml version="1.0"?>
<sdf version="1.9">
  <model name="office_printer">
    <static>true</static>
    <link name="body">
      <!-- Keep the collision footprint identical to the obstacle encoded in
           semantic_office_lab.pgm. -->
      <collision name="collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><box><size>0.8 0.6 0.9</size></box></geometry>
      </collision>

      <visual name="cabinet">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><box><size>0.72 0.54 0.60</size></box></geometry>
        <material><ambient>0.72 0.73 0.75 1</ambient><diffuse>0.82 0.83 0.85 1</diffuse></material>
      </visual>
      <visual name="cabinet_divider">
        <pose>0 -0.276 0.32 0 0 0</pose>
        <geometry><box><size>0.62 0.012 0.025</size></box></geometry>
        <material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.25 0.26 0.28 1</diffuse></material>
      </visual>
      <visual name="printer_body">
        <pose>0 0 0.70 0 0 0</pose>
        <geometry><box><size>0.68 0.50 0.20</size></box></geometry>
        <material><ambient>0.13 0.14 0.16 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse></material>
      </visual>
      <visual name="output_slot">
        <pose>0 -0.256 0.70 0 0 0</pose>
        <geometry><box><size>0.42 0.018 0.08</size></box></geometry>
        <material><ambient>0.01 0.01 0.015 1</ambient><diffuse>0.02 0.02 0.025 1</diffuse></material>
      </visual>
      <visual name="output_tray">
        <pose>0 -0.31 0.66 -0.18 0 0</pose>
        <geometry><box><size>0.46 0.16 0.025</size></box></geometry>
        <material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.19 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="paper">
        <pose>0 -0.32 0.68 -0.18 0 0</pose>
        <geometry><box><size>0.36 0.15 0.008</size></box></geometry>
        <material><ambient>0.92 0.92 0.90 1</ambient><diffuse>0.98 0.98 0.96 1</diffuse></material>
      </visual>
      <visual name="scanner">
        <pose>0 0 0.83 0 0 0</pose>
        <geometry><box><size>0.72 0.52 0.08</size></box></geometry>
        <material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.34 0.35 0.38 1</diffuse></material>
      </visual>
      <visual name="scanner_lid">
        <pose>0 0 0.89 0 0 0</pose>
        <geometry><box><size>0.66 0.46 0.04</size></box></geometry>
        <material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.13 0.14 0.16 1</diffuse></material>
      </visual>
      <visual name="control_panel">
        <pose>0.22 -0.275 0.82 1.30 0 0</pose>
        <geometry><box><size>0.20 0.09 0.025</size></box></geometry>
        <material><ambient>0.03 0.09 0.13 1</ambient><diffuse>0.04 0.18 0.25 1</diffuse><emissive>0.01 0.08 0.12 1</emissive></material>
      </visual>
    </link>
  </model>
</sdf>
