<?xml version="1.0"?>

<model>
  <name>TurtleBot3(Waffle) semantic</name>
  <version>2.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Taehun Lim(Darby)</name>
    <email>thlim@robotis.com</email>
  </author>

  <description>
    TurtleBot3 Waffle with the RGB camera raised on a mast (height set at
    launch time via the camera_mast_z argument) and 640x480 resolution,
    vendored from turtlebot3_gazebo for the visual-semantic navigation stack.
  </description>
</model>
