<?xml version="1.0"?>

<sdf version="1.6">
  <model name="monitor_and_keyboard">
    <static>true</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

      <visual name="visual_monitor">
        <geometry>
          <mesh>
            <uri>meshes/monitor.obj</uri>
            <scale>0.20 0.20 0.20</scale>
          </mesh>
        </geometry>
        <pose>0 0 0 0 0 0</pose>
      </visual>

      <collision name="collision_monitor">
        <pose>-0.024 -0.016 0.294 0 0 0</pose>
        <geometry>
          <box><size>0.21 0.79 0.59</size></box>
        </geometry>
      </collision>

      <visual name="visual_keyboard">
        <geometry>
          <mesh>
            <uri>meshes/keyboard.obj</uri>
            <scale>0.20 0.20 0.20</scale>
          </mesh>
        </geometry>
        <pose>-0.27 0 0 0 0 0</pose>
      </visual>

      <collision name="collision_keyboard">
        <pose>-0.271 -0.014 0.028 0 0 0</pose>
        <geometry>
          <box><size>0.24 0.57 0.056</size></box>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
