<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.6">
  <model name="office_desk">
    <static>true</static>
    <link name="base_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/desk.dae</uri>
            <!-- Match the 1.4 x 0.7 m workstation footprint in the map. -->
            <scale>0.84 0.622 1.0</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/Desk_Albedo.png</albedo_map>
              <normal_map>materials/textures/Desk_Normal.png</normal_map>
              <roughness_map>materials/textures/Desk_Roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- A conservative footprint keeps Gazebo collision aligned with the
           static Nav2 map while avoiding an expensive decorated mesh. -->
      <collision name="workstation_collision">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><box><size>0.7 1.4 1.1</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
