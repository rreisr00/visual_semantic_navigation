<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="ceiling_light" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision"><geometry><box><size>12 8 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 8 0.1</size></box></geometry>
          <material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.72 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer shell and two partitions with deliberately wide door openings. -->
    <model name="wall_north"><static>true</static><pose>0 4 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>12 0.15 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>12 0.15 2.5</size></box></geometry><material><diffuse>0.86 0.86 0.82 1</diffuse></material></visual>
    </link></model>
    <model name="wall_south"><static>true</static><pose>0 -4 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>12 0.15 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>12 0.15 2.5</size></box></geometry><material><diffuse>0.86 0.86 0.82 1</diffuse></material></visual>
    </link></model>
    <model name="wall_west"><static>true</static><pose>-6 0 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.15 8 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 8 2.5</size></box></geometry><material><diffuse>0.86 0.86 0.82 1</diffuse></material></visual>
    </link></model>
    <model name="wall_east"><static>true</static><pose>6 0 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.15 8 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 8 2.5</size></box></geometry><material><diffuse>0.86 0.86 0.82 1</diffuse></material></visual>
    </link></model>
    <model name="partition_center_north"><static>true</static><pose>0 2.35 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.15 3.3 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 3.3 2.5</size></box></geometry><material><diffuse>0.8 0.84 0.88 1</diffuse></material></visual>
    </link></model>
    <model name="partition_center_south"><static>true</static><pose>0 -2.35 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.15 3.3 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 3.3 2.5</size></box></geometry><material><diffuse>0.8 0.84 0.88 1</diffuse></material></visual>
    </link></model>
    <model name="partition_east_left"><static>true</static><pose>1 0 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>2 0.15 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2 0.15 2.5</size></box></geometry><material><diffuse>0.8 0.84 0.88 1</diffuse></material></visual>
    </link></model>
    <model name="partition_east_right"><static>true</static><pose>5 0 1.25 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>2 0.15 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2 0.15 2.5</size></box></geometry><material><diffuse>0.8 0.84 0.88 1</diffuse></material></visual>
    </link></model>

    <!-- Repeated workstations in the open lab. -->
    <model name="desk_north"><static>true</static><pose>-3 2 0.4 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>1.4 0.7 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.4 0.7 0.8</size></box></geometry><material><diffuse>0.48 0.27 0.12 1</diffuse></material></visual>
    </link></model>
    <model name="monitor_north"><static>true</static><pose>-3 2 1.05 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.55 0.12 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.55 0.12 0.4</size></box></geometry><material><diffuse>0.03 0.05 0.08 1</diffuse></material></visual>
    </link></model>
    <model name="cup_north"><static>true</static><pose>-2.55 1.86 0.92 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.06</radius><length>0.14</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.14</length></cylinder></geometry><material><diffuse>0.9 0.15 0.1 1</diffuse></material></visual>
    </link></model>
    <model name="chair_north"><static>true</static><pose>-3 1.15 0.45 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.55 0.55 0.9</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.55 0.55 0.9</size></box></geometry><material><diffuse>0.12 0.24 0.65 1</diffuse></material></visual>
    </link></model>
    <model name="desk_south"><static>true</static><pose>-3 -2 0.4 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>1.4 0.7 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.4 0.7 0.8</size></box></geometry><material><diffuse>0.48 0.27 0.12 1</diffuse></material></visual>
    </link></model>
    <model name="monitor_south"><static>true</static><pose>-3 -2 1.05 0 0 3.14159</pose><link name="link">
      <collision name="c"><geometry><box><size>0.55 0.12 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.55 0.12 0.4</size></box></geometry><material><diffuse>0.03 0.05 0.08 1</diffuse></material></visual>
    </link></model>
    <model name="cup_south"><static>true</static><pose>-2.55 -1.86 0.92 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.06</radius><length>0.14</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.14</length></cylinder></geometry><material><diffuse>0.1 0.75 0.25 1</diffuse></material></visual>
    </link></model>
    <model name="chair_south"><static>true</static><pose>-3 -1.15 0.45 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.55 0.55 0.9</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.55 0.55 0.9</size></box></geometry><material><diffuse>0.12 0.24 0.65 1</diffuse></material></visual>
    </link></model>

    <!-- Meeting room, printer area and shelf. -->
    <model name="meeting_table"><static>true</static><pose>3 2 0.4 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>2 1 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2 1 0.8</size></box></geometry><material><diffuse>0.55 0.36 0.2 1</diffuse></material></visual>
    </link></model>
    <model name="plant"><static>true</static><pose>5 3 0.45 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry></collision>
      <visual name="pot"><geometry><cylinder><radius>0.25</radius><length>0.45</length></cylinder></geometry><material><diffuse>0.45 0.2 0.08 1</diffuse></material></visual>
      <visual name="leaves"><pose>0 0 0.45 0 0 0</pose><geometry><sphere><radius>0.42</radius></sphere></geometry><material><diffuse>0.08 0.55 0.12 1</diffuse></material></visual>
    </link></model>
    <model name="printer"><static>true</static><pose>2 -2 0.45 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.8 0.6 0.9</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.8 0.6 0.9</size></box></geometry><material><diffuse>0.18 0.18 0.2 1</diffuse></material></visual>
    </link></model>
    <model name="bookshelf"><static>true</static><pose>5 -2 1 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.5 2 2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 2 2</size></box></geometry><material><diffuse>0.35 0.18 0.08 1</diffuse></material></visual>
    </link></model>
    <model name="window_north"><static>true</static><pose>3.5 3.9 1.45 1.5708 0 0</pose><link name="link">
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>2 1.1</size></plane></geometry><material><diffuse>0.25 0.65 0.9 0.7</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
