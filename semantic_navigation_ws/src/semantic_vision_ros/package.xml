<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_vision_ros</name>
  <version>0.1.0</version>
  <description>
    ROS 2 lifecycle wrapper for semantic_vision_core.
    Exposes a stateless GetVisualFeatures service (SigLIP + optional YOLO).
  </description>
  <maintainer email="rreisr00@estudiantes.unileon.es">developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>semantic_interfaces</exec_depend>
  <exec_depend>semantic_navigation_core</exec_depend>
  <exec_depend>semantic_vision_core</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
