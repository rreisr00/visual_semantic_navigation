# Define (or redefine) a room polygon in the map frame. When polygon has fewer
# than three vertices, the legacy min/max rectangle is used.
string room_id
float64 min_x
float64 min_y
float64 max_x
float64 max_y
geometry_msgs/Point32[] polygon
float64 transition_width_m
---
bool success
string message
int32 waypoints_assigned   # CONTAINS room->waypoint edges after the sweep
