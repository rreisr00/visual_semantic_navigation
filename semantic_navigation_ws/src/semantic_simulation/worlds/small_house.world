<?xml version="1.0"?>
<!--
  AWS Small House World for Gazebo.

  To use the full AWS Small House world assets, install the
  aws-robomaker-small-house-world ROS 2 package:

    sudo apt-get install ros-${ROS_DISTRO}-aws-robomaker-small-house-world

  and then point the world launch argument to:
    /opt/ros/${ROS_DISTRO}/share/aws_robomaker_small_house_world/worlds/small_house.world

  This stub world is provided so that the package builds even without the
  AWS world assets installed.
-->
<sdf version="1.6">
  <world name="small_house">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <!-- TurtleBot3 Waffle is spawned by the turtlebot3_gazebo launch file -->
  </world>
</sdf>
